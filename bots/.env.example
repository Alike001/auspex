# Auspex bots — copy to .env and fill with FUNDED Shannon testnet keys.
# .env is gitignored; NEVER commit real private keys.

# Funded wallet that posts + funds jobs (needs ≥ 1 STT).
DATA_FETCHER_PRIVATE_KEY=0x...

# Wallet that delivers + claims. Its address becomes each job's deliverer.
SCRAPER_PRIVATE_KEY=0x...

# Optional RPC override (defaults to the Shannon public RPC).
# SHANNON_RPC_URL=https://api.infra.testnet.somnia.network
